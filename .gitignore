# The xcframeworks are release assets, not repo contents — see Package.swift.
# Each slice of the SDK framework is over GitHub's 100 MB per-file limit, and
# committing them would add ~170 MB to this repo's history per release.
SensorBio/
*.xcframework
*.xcframework.zip

# The ExampleApp is a Swift Package consumer (XCLocalSwiftPackageReference "..").
# CocoaPods artefacts and build output are not repo contents; a committed
# Pods/ also gave customers an ExampleApp.xcworkspace that opened the old
# CocoaPods project instead of the SPM one.
ExampleApp/Pods/
ExampleApp/ExampleApp.xcworkspace/
ExampleApp/build/
