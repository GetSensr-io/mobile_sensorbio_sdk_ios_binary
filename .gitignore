.DS_Store

# Xcode per-user state
.swiftpm/xcode/xcuserdata/
.swiftpm/xcode/package.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# CocoaPods — NoomApp regenerates Pods/ on `pod install`; don't commit it.
# Podfile.lock IS committed so customers run against the same resolution.
NoomApp/Pods/
NoomApp/*.xcworkspace/

# Local agent worktrees / files
.claude/
.kanban-backend/

# Generated Xcode build output and local QA evidence
NoomApp/build/
NoomApp/qa-artifacts/
docs/mockups/noom-mobile-mockups/screenshots/

# Node / Convex local dependencies
node_modules/
.env.local
